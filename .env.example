# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook Secret (generate with: openssl rand -base64 32)
# This is used to verify webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Admin Chat ID for /stats command access
# Get your chat ID by messaging @userinfobot on Telegram
# Can be comma-separated for multiple admins (e.g., "123456,789012")
ADMIN_CHAT_ID=your_chat_id_here

# Note: These should be set using `wrangler secret put` for production
# For local development, you can use .dev.vars file (create it manually)
